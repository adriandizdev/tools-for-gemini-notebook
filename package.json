{
  "name": "notebooklmtopdf",
  "description": "Extensión de Chrome que exporta conversaciones de NotebookLM a PDF conservando fórmulas y ecuaciones",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
