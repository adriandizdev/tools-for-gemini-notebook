  "dependencies": {
    "dompurify": "^3.4.16",
    "katex": "^0.19.0"
  },
  "devDependencies": {
    "jsdom": "^28.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
